(defun c:inspect-dwg ()
  (princ "\n--- INSPECTING BLOCKS IN DRAWING ---\n")
  (setq ss (ssget "X" '((0 . "INSERT"))))
  (if ss
    (progn
      (setq len (sslength ss))
      (princ (strcat "Total block references: " (itoa len) "\n"))
      (setq blockList '())
      (setq i 0)
      (while (< i len)
        (setq ent (ssname ss i))
        (setq d (entget ent))
        (setq bname (cdr (assoc 2 d)))
        (setq pt (cdr (assoc 10 d)))
        (setq layer (cdr (assoc 8 d)))
        (if (< i 20)
          (princ (strcat "Block: " bname " | Layer: " layer " | Pt: (" (rtos (car pt) 2 2) ", " (rtos (cadr pt) 2 2) ")\n"))
        )
        (if (not (assoc bname blockList))
          (setq blockList (cons (cons bname 1) blockList))
          (setq blockList (subst (cons bname (1+ (cdr (assoc bname blockList)))) (assoc bname blockList) blockList))
        )
        (setq i (1+ i))
      )
      (princ "\n--- BLOCK SUMMARY ---\n")
      (foreach b blockList
        (princ (strcat (car b) ": " (itoa (cdr b)) "\n"))
      )
    )
    (princ "No blocks found.\n")
  )
  (princ "\n--- INSPECTING UNITS & EXTENTS ---\n")
  (princ (strcat "INSUNITS: " (itoa (getvar "INSUNITS")) "\n"))
  (princ (strcat "LUNITS: " (itoa (getvar "LUNITS")) "\n"))
  (princ (strcat "EXTMIN: (" (rtos (car (getvar "EXTMIN")) 2 2) ", " (rtos (cadr (getvar "EXTMIN")) 2 2) ")\n"))
  (princ (strcat "EXTMAX: (" (rtos (car (getvar "EXTMAX")) 2 2) ", " (rtos (cadr (getvar "EXTMAX")) 2 2) ")\n"))
  (princ "\nDONE\n")
  (command "_QUIT" "_Y")
)
(c:inspect-dwg)
